  {
   "type": "stat",
   "title": "App chạy",
   "description": "Số instance w1-app đang gửi thống kê (mỗi GPU 1 instance)",
   "datasource": {
    "type": "prometheus",
    "uid": "ds-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "ds-prom"
     },
     "expr": "sum(ds_app_up{prefix=~\"$prefix\"})",
     "legendFormat": "instance"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "id": 1
  },
